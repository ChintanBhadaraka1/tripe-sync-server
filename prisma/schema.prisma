// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  createdTrips        Trip[]       @relation("TripCreator")
  tripMemberships     TripMember[]
  sentInvitations     Invitation[] @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationReceiver")
  uploadedDocuments   TripDocument[] @relation("DocumentUploader")
  personalDocuments   UserDocument[] @relation("PersonalDocuments")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Trips ───────────────────────────────────────────────────────────────────

model Trip {
  id              String    @id @default(cuid())
  name            String
  description     String?
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  shareCode       String    @unique @map("share_code")
  createdById     String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy   User         @relation("TripCreator", fields: [createdById], references: [id])
  members     TripMember[]
  invitations Invitation[]
  transactions Transaction[]
  personalExpenses PersonalExpense[]
  settlements Settlement[]
  travelTickets TravelTicket[]
  hotelBookings HotelBooking[]
  rentalDetails RentalDetail[]
  documents   TripDocument[]
  sharedUserDocs SharedUserDocument[]
  itineraryDays ItineraryDay[]

  @@index([createdById])
  @@map("trips")
}

model TripMember {
  id          String       @id @default(cuid())
  tripId      String       @map("trip_id")
  userId      String?      @map("user_id") // Nullable for placeholders
  displayName String?      @map("display_name") // E.g., "Member 1", "Rahul"
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now()) @map("joined_at")
  claimedAt   DateTime?    @map("claimed_at")

  trip               Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionPayers  TransactionPayer[]
  transactionSplits  TransactionSplit[]
  settlementsPaid    Settlement[]       @relation("SettlementPayer")
  settlementsReceived Settlement[]      @relation("SettlementReceiver")

  @@unique([tripId, userId]) // Postgres allows multiple nulls here
  @@index([userId])
  @@index([tripId])
  @@map("trip_members")
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MemberStatus {
  PLACEHOLDER
  ACTIVE
  REMOVED
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id            String           @id @default(cuid())
  tripId        String           @map("trip_id")
  invitedById   String           @map("invited_by")
  invitedEmail  String           @map("invited_email")
  invitedUserId String?          @map("invited_user_id")
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  trip        Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitationSender", fields: [invitedById], references: [id])
  invitedUser User? @relation("InvitationReceiver", fields: [invitedUserId], references: [id])

  @@index([invitedEmail])
  @@index([invitedUserId])
  @@index([tripId])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Transactions & Balances ──────────────────────────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  title       String
  amount      Int      // In paise (₹1 = 100 paise)
  category    String   @default("other")
  date        DateTime @default(now())
  note        String?
  splitType   SplitType @default(EQUAL) @map("split_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip   Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payers TransactionPayer[]
  splits TransactionSplit[]
  travelTickets TravelTicket[]
  hotelBookings HotelBooking[]
  rentalDetails RentalDetail[]

  @@index([tripId])
  @@index([date])
  @@map("transactions")
}

model TransactionPayer {
  id             String @id @default(cuid())
  transactionId  String @map("transaction_id")
  memberId       String @map("member_id")
  paidAmount     Int    @map("paid_amount") // In paise

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member      TripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([memberId])
  @@map("transaction_payers")
}

model TransactionSplit {
  id             String @id @default(cuid())
  transactionId  String @map("transaction_id")
  memberId       String @map("member_id")
  owedAmount     Int    @map("owed_amount") // In paise
  share          Decimal? // Used for percentage or shares split

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member      TripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([memberId])
  @@map("transaction_splits")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

// ─── Personal Expenses ────────────────────────────────────────────────────────

model PersonalExpense {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  userId      String   @map("user_id") // Tied to a real user, not a placeholder
  title       String
  amount      Int      // In paise
  category    String   @default("other")
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@map("personal_expenses")
}

// ─── Settlements ──────────────────────────────────────────────────────────────

model Settlement {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  payerId     String   @map("payer_id")
  receiverId  String   @map("receiver_id")
  amount      Int      // In paise
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer    TripMember @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Cascade)
  receiver TripMember @relation("SettlementReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([payerId])
  @@index([receiverId])
  @@map("settlements")
}

// ─── Logistics (Phase 5) ──────────────────────────────────────────────────────

model TravelTicket {
  id            String    @id @default(cuid())
  tripId        String    @map("trip_id")
  mode          String    // train, bus, flight
  fromPlace     String    @map("from_place")
  toPlace       String    @map("to_place")
  departureAt   DateTime  @map("departure_at")
  arrivalAt     DateTime? @map("arrival_at")
  pnr           String?
  seatInfo      String?   @map("seat_info")
  cost          Int?      // In paise
  documentUrl   String?   @map("document_url")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("travel_tickets")
}

model HotelBooking {
  id            String    @id @default(cuid())
  tripId        String    @map("trip_id")
  hotelName     String    @map("hotel_name")
  address       String?
  checkIn       DateTime  @map("check_in")
  checkOut      DateTime  @map("check_out")
  bookingRef    String?   @map("booking_ref")
  cost          Int?      // In paise
  documentUrl   String?   @map("document_url")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("hotel_bookings")
}

model RentalDetail {
  id            String    @id @default(cuid())
  tripId        String    @map("trip_id")
  type          String    // car, bike
  vendor        String
  pickupAt      DateTime  @map("pickup_at")
  dropAt        DateTime  @map("drop_at")
  deposit       Int?      // In paise
  cost          Int?      // In paise
  documentUrl   String?   @map("document_url")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("rental_details")
}

// ─── Documents (Phase 6) ──────────────────────────────────────────────────────

// Trip-specific documents
model TripDocument {
  id         String   @id @default(cuid())
  tripId     String   @map("trip_id")
  title      String
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user       User     @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([uploadedBy])
  @@map("trip_documents")
}

// Global personal documents
model UserDocument {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  title      String
  fileUrl    String   @map("file_url")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation("PersonalDocuments", fields: [userId], references: [id], onDelete: Cascade)
  sharedIn   SharedUserDocument[]

  @@index([userId])
  @@map("user_documents")
}

model SharedUserDocument {
  id             String   @id @default(cuid())
  tripId         String   @map("trip_id")
  userDocumentId String   @map("user_document_id")
  sharedAt       DateTime @default(now()) @map("shared_at")

  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userDocument   UserDocument @relation(fields: [userDocumentId], references: [id], onDelete: Cascade)

  @@unique([tripId, userDocumentId])
  @@index([tripId])
  @@index([userDocumentId])
  @@map("shared_user_documents")
}

// ─── Itinerary & Map View (Phase 7) ──────────────────────────────────────────

model ItineraryDay {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  date      DateTime
  dayNumber Int      @map("day_number")

  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]

  @@unique([tripId, date])
  @@unique([tripId, dayNumber])
  @@index([tripId])
  @@map("itinerary_days")
}

model ItineraryItem {
  id        String   @id @default(cuid())
  dayId     String   @map("day_id")
  title     String
  time      DateTime?
  type      String   // hotel, travel, activity, food, other
  notes     String?
  photoUrl  String?  @map("photo_url")
  sortOrder Int      @default(0) @map("sort_order")

  // Map & Location Fields
  placeName String?  @map("place_name")
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  mapLink   String?  @map("map_link")

  // Travel Routing Fields (Optional for lines between cities)
  fromLat   Decimal? @map("from_lat") @db.Decimal(9, 6)
  fromLng   Decimal? @map("from_lng") @db.Decimal(9, 6)
  toLat     Decimal? @map("to_lat") @db.Decimal(9, 6)
  toLng     Decimal? @map("to_lng") @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  day       ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@map("itinerary_items")
}
